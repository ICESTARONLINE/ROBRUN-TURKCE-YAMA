<?xml version="1.0" encoding="UTF-8" ?>
<Page
    x:Class="RobRunTurkceYama.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="#1C1C1C">

    <Grid VerticalAlignment="Top">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border
            x:Name="AppTitleBar"
            Background="#1C1C1C"
            Height="40"
            Padding="12,0,140,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                <Image
                    Source="ms-appx:///Assets/AppIcon.png"
                    Width="22"
                    Height="22"
                    Stretch="Uniform" />
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="13"
                    Opacity="0.85"
                    Text="ROB RUN Türkçe Yama" />
            </StackPanel>
        </Border>

        <Grid
            Grid.Row="1"
            Padding="28,8,28,6"
            RowSpacing="8"
            ColumnSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header + action buttons top-right -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid ColumnSpacing="14" VerticalAlignment="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image
                        Source="ms-appx:///Assets/AppIcon.png"
                        Width="56"
                        Height="56"
                        Stretch="Uniform"
                        VerticalAlignment="Top"
                        Margin="0,4,0,0" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Top" Spacing="3" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock
                                Style="{StaticResource BrandTitleText}"
                                VerticalAlignment="Bottom"
                                Text="ROB RUN" />
                            <TextBlock
                                Style="{StaticResource BrandTitleText}"
                                VerticalAlignment="Bottom"
                                FontSize="28"
                                Foreground="#E53935"
                                Text="Türkçe Yama" />
                        </StackPanel>
                        <TextBlock
                            FontSize="10"
                            Opacity="0.55"
                            TextWrapping="WrapWholeWords"
                            Text="Bu site ve Türkçe yama ROB RUN, Kefir ve Steam ile bağlantılı değildir; resmi olmayan hayran çalışmasıdır. ROB RUN ticari markaları ilgili sahiplerine aittir." />
                    </StackPanel>
                </Grid>

                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="8"
                    VerticalAlignment="Top"
                    Margin="0,8,0,0"
                    HorizontalAlignment="Right">
                    <Button
                        x:Name="InstallButton"
                        Click="OnInstallClicked"
                        Style="{StaticResource InstallGreenButtonStyle}"
                        MinWidth="170"
                        Height="40"
                        Padding="12,0">
                        <Button.Resources>
                            <SolidColorBrush x:Key="ButtonBackground" Color="#43A047" />
                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#4CAF50" />
                            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#2E7D32" />
                            <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#6643A047" />
                            <SolidColorBrush x:Key="ButtonBorderBrush" Color="#2E7D32" />
                            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#388E3C" />
                            <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#1B5E20" />
                            <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="#442E7D32" />
                            <SolidColorBrush x:Key="ButtonForeground" Color="#FFFFFF" />
                            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FFFFFF" />
                            <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#FFFFFF" />
                            <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#99FFFFFF" />
                        </Button.Resources>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE896;" FontSize="15" Foreground="#FFFFFF" />
                            <TextBlock Text="Türkçe Yamayı Kur" VerticalAlignment="Center" Foreground="#FFFFFF" />
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="UninstallButton"
                        Click="OnUninstallClicked"
                        Style="{StaticResource UninstallRedButtonStyle}"
                        MinWidth="140"
                        Height="40"
                        Padding="12,0">
                        <Button.Resources>
                            <SolidColorBrush x:Key="ButtonBackground" Color="#E53935" />
                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#EF5350" />
                            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#C62828" />
                            <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#66E53935" />
                            <SolidColorBrush x:Key="ButtonBorderBrush" Color="#C62828" />
                            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#E53935" />
                            <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#B71C1C" />
                            <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="#44C62828" />
                            <SolidColorBrush x:Key="ButtonForeground" Color="#FFFFFF" />
                            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FFFFFF" />
                            <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#FFFFFF" />
                            <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#99FFFFFF" />
                        </Button.Resources>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE7A7;" FontSize="15" Foreground="#FFFFFF" />
                            <TextBlock Text="Yamayı Kaldır" VerticalAlignment="Center" Foreground="#FFFFFF" />
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="RefreshButton"
                        Click="OnRefreshClicked"
                        MinWidth="96"
                        Height="40"
                        Padding="12,0">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE72C;" FontSize="15" />
                            <TextBlock Text="Yenile" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Oyun klasörü + Durum tek satır -->
            <Grid Grid.Row="1" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.6*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="14">
                    <Grid ColumnSpacing="8" RowSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Style="{StaticResource BrandSectionText}" Text="Oyun klasörü" />
                        <TextBox
                            x:Name="PathBox"
                            Grid.Row="1"
                            IsReadOnly="True"
                            PlaceholderText="Steam / ROB RUN klasörü otomatik aranacak..." />
                        <Button
                            x:Name="DetectButton"
                            Grid.Row="1"
                            Grid.Column="1"
                            Click="OnDetectClicked"
                            MinWidth="84"
                            Height="36"
                            Padding="10,0">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE721;" FontSize="14" />
                                <TextBlock Text="Bul" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="BrowseButton"
                            Grid.Row="1"
                            Grid.Column="2"
                            Click="OnBrowseClicked"
                            MinWidth="92"
                            Height="36"
                            Padding="10,0">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                                <TextBlock Text="Gözat" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <Border
                    Grid.Column="1"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="14">
                    <StackPanel Spacing="8" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource BrandSectionText}" Text="Durum" />
                        <Border
                            x:Name="StatusBadge"
                            HorizontalAlignment="Left"
                            CornerRadius="8"
                            Padding="10,6"
                            Background="#33CF4646">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon
                                    x:Name="StatusIcon"
                                    Glyph="&#xE783;"
                                    FontSize="14"
                                    Foreground="#CF4646"
                                    VerticalAlignment="Center" />
                                <TextBlock
                                    x:Name="StatusText"
                                    Style="{StaticResource BrandSectionText}"
                                    FontSize="16"
                                    VerticalAlignment="Center"
                                    Text="Kontrol ediliyor..." />
                            </StackPanel>
                        </Border>
                        <TextBlock
                            x:Name="DetailText"
                            Opacity="0.8"
                            FontSize="12"
                            TextWrapping="WrapWholeWords"
                            Text="" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Row="2" Margin="0,2,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    Margin="4,0,16,0"
                    VerticalAlignment="Center"
                    FontSize="10"
                    Opacity="0.55"
                    TextWrapping="WrapWholeWords"
                    Text="Önemli: Bu resmi olmayan bir hayran yamasıdır. İndirme, kurma ve kullanımdan doğan tüm sorumluluk size aittir." />
                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="6"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Margin="4,0,4,0">
                    <TextBlock VerticalAlignment="Center" FontSize="12" Opacity="0.9">
                        <Run FontWeight="SemiBold" Text="ICESTAR" /><Run Text=" tarafından" />
                    </TextBlock>
                    <FontIcon
                        Glyph="&#xEB52;"
                        FontSize="13"
                        Foreground="#E53935"
                        VerticalAlignment="Center" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="12"
                        Opacity="0.9"
                        Text="sevgiyle kodlandı." />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Page>
