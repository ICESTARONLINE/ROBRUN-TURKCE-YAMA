<?xml version="1.0" encoding="UTF-8" ?>
<Application
    x:Class="RobRunTurkceYama.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    RequestedTheme="Dark"
    mc:Ignorable="d">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Dosya zaten Black Italic; FontStyle=Italic eklenirse bazı glifler (i) boş düşer -->
            <FontFamily x:Key="RubikBlackItalic">ms-appx:///Assets/Fonts/Rubik-BlackItalic.ttf#Rubik</FontFamily>
            <FontFamily x:Key="UiTextFont">Segoe UI Variable Text, Segoe UI</FontFamily>

            <Style x:Key="BrandTitleText" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource RubikBlackItalic}" />
                <Setter Property="FontSize" Value="34" />
                <Setter Property="FontStyle" Value="Normal" />
                <Setter Property="CharacterSpacing" Value="-20" />
            </Style>

            <Style x:Key="BrandSectionText" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource UiTextFont}" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="FontStyle" Value="Normal" />
            </Style>

            <Style x:Key="DonationChipStyle" TargetType="HyperlinkButton">
                <Setter Property="Padding" Value="6,10" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="MinHeight" Value="64" />
            </Style>

            <!-- Dolu (eski hover görünümü): yeşil / kırmızı — brush’lar buton Resources’ta -->
            <Style x:Key="InstallGreenButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="#43A047" />
                <Setter Property="Foreground" Value="#FFFFFF" />
                <Setter Property="BorderBrush" Value="#2E7D32" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>

            <Style x:Key="UninstallRedButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="#E53935" />
                <Setter Property="Foreground" Value="#FFFFFF" />
                <Setter Property="BorderBrush" Value="#C62828" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
